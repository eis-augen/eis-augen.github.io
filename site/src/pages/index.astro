---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import '../styles/global.css';

const skillLabels: Record<string, string> = {
  frontend: 'Frontend',
  backend: 'Backend y APIs',
  mobile: 'Móvil',
  desktop: 'Escritorio',
  datos: 'Datos y despliegue',
  infra: 'Infraestructura',
  herramientas: 'Herramientas',
};
---
<BaseLayout
  title={`${profile.name} — portafolio`}
  description={profile.bio}
>
  <div class="wrap">
    <header class="topbar">
      <a class="brand" href="/">{profile.name}</a>
      <nav class="nav" aria-label="Secciones">
        <a href="#proyectos">Proyectos</a>
        <a href="#tecnologias">Tecnologías</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </header>

    <section class="hero">
      <h1>{profile.name}</h1>
      <p class="headline">{profile.headline}</p>
      <p class="bio">{profile.bio}</p>
    </section>

    <section id="tecnologias" class="block">
      <h2>Tecnologías</h2>
      <div class="skills">
        {Object.entries(profile.skills).map(([key, items]) => (
          <div class="skill-group">
            <h3>{skillLabels[key] ?? key}</h3>
            <ul>
              {items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section id="proyectos" class="block">
      <h2>Proyectos</h2>
      <p class="section-lead">
        Trabajo publicado y en uso. Cada ficha lleva captura real de la interfaz.
      </p>
      <div class="projects">
        {projects.map((p) => (
          <article class="project-card">
            <a class="thumb" href={`/proyectos/${p.slug}/`}>
              <img src={p.image} alt={`Captura de ${p.title}`} width="400" height="225" loading="lazy" />
            </a>
            <div>
              <h3><a href={`/proyectos/${p.slug}/`}>{p.title}</a></h3>
              <p class="tag">{p.tagline}</p>
              <p>{p.summary}</p>
              <ul class="stack">
                {p.stack.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <footer id="contacto" class="site-foot">
      <p>
        <a href={profile.contact.github} rel="noopener noreferrer">{profile.contact.label}</a>
      </p>
    </footer>
  </div>
</BaseLayout>
