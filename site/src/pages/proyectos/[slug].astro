---
import BaseLayout from '../../layouts/BaseLayout.astro';
import projects from '../../data/projects.json';
import profile from '../../data/profile.json';
import '../../styles/global.css';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const shots = project.shots ?? [project.image];
---
<BaseLayout title={`${project.title} — ${profile.name}`} description={project.summary}>
  <div class="wrap">
    <header class="topbar">
      <a class="brand" href="/">{profile.name}</a>
      <nav class="nav">
        <a href="/#proyectos">← Proyectos</a>
      </nav>
    </header>

    <article class="project-detail">
      <h1>{project.title}</h1>
      <p class="headline">{project.tagline}</p>
      <p class="bio">{project.summary}</p>
      {project.liveUrl && (
        <p class="live-link">
          <a href={project.liveUrl} rel="noopener noreferrer">Abrir sitio en línea</a>
        </p>
      )}
      <ul class="stack" style="margin-top: 1rem;">
        {project.stack.map((t) => <li>{t}</li>)}
      </ul>

      <section class="block">
        <h2>En pantalla</h2>
        <div class="shot-gallery">
          {shots.map((src) => (
            <figure>
              <img src={src} alt={`${project.title} — captura`} loading="lazy" />
            </figure>
          ))}
        </div>
      </section>

      <section class="block">
        <h2>Detalle del trabajo</h2>
        <ul class="detail-list">
          {project.highlights.map((h) => <li>{h}</li>)}
        </ul>
      </section>
    </article>
  </div>
</BaseLayout>
